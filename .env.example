# ==========================================
# Frontend (Vite + Vercel) Configuration
# ==========================================

# Backend FastAPI Base URL
# - Local Dev (Docker compose / local uvicorn):
#   VITE_API_BASE=http://localhost:8000
# - Production (Backend deployed di Railway):
#   VITE_API_BASE=https://hartaku-backend-production.up.railway.app
#
# Note: Jangan pakai trailing slash di akhir URL!
VITE_API_BASE=http://localhost:8000

# Opsional: Override API base via runtime window injection (untuk CDN / multi-tenant)
# window.HARTAKU_API_BASE akan dipakai duluan jika ada (cek src/main.js baris 14)
